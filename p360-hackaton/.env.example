VITE_APP_NAME=Hackaton
VITE_PORT=9000

# Backend base — vazio = usa caminho relativo (Vite dev proxy resolve).
# Em produção, definir com a URL do gateway.
VITE_HACKATON_API_URL=

# Bearer opcional — não usado quando a auth é via X-Access-Token do host.
VITE_HACKATON_API_TOKEN=

# Mock desligado pra bater no backend real.
VITE_USE_MOCK=true

# Base do storage (imagens de caso). O front monta STORAGE_URL + "catalogo/" + imagem.
VITE_STORAGE_URL=https://s3-sa-east-1.amazonaws.com/avp-development/

# p360-auth-front — usado quando o aluno abre a sala por link avulso e a
# atividade exige login (caso clínico, simulado). O auth volta com ?t=<token>.
# Portas por ambiente seguem o AUTH_URL do avp-empresas (local: 4000;
# dev/stg/prod: https://{dev-,stg-,}auth.paciente360.com.br/).
VITE_P360_AUTH_URL=http://localhost:4000/

# Monolith (poll360). O professor conecta direto no gateway /ws/poll360 para
# controlar a enquete ao vivo — é lá que o "speaker" é reconhecido pelo token.
VITE_POLL360_WS_URL=http://localhost:3001
