NODE_ENV=development
PORT=8000

# Comma-separated allow-list para CORS (default `*` permite qualquer origem).
# Restrinja fora de PoC, ex.: CORS_ALLOW_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGINS=*

# API HTTP do P360 legado — usada pelo AccessTokenGuard para validar o
# header X-Access-Token contra POST /users/get-token-info.
# Dentro do Docker use host.docker.internal em vez de localhost.
LEGACY_API_BASE_URL=http://localhost:3000

# PostgreSQL (casa com o serviço db do compose). Prisma usa DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/p360-hackaton-backend?schema=public

# PostgreSQL legado (banco `avp`) — leitura read-only do acervo de casos
# clínicos pela busca por tema. Senha vem do avp-backend/.env (DB_PASSWORD).
# Dentro do Docker use host.docker.internal em vez de localhost.
LEGACY_PGHOST=localhost
LEGACY_PGPORT=5432
LEGACY_PGUSER=postgres
LEGACY_PGPASSWORD=
LEGACY_PGDATABASE=avp
# Opcional: réplica de leitura (cai para LEGACY_PGHOST quando vazio).
LEGACY_PGHOST_READ=

# Credencial de ESCRITA no legado — usada só para preparar/liberar o caso da
# aula (curso-wrapper, atribuição à turma, matrícula). Separada da leitura para
# permitir privilégio mínimo no banco (INSERT/UPDATE em curso, cursoaula,
# empresacurso, turmacurso, turmausuario). Cai para as credenciais de leitura.
LEGACY_PGUSER_WRITE=
LEGACY_PGPASSWORD_WRITE=

# Base do avp-empresas (host legado). Usada para montar o link do caso em modo
# quiosque: ?t=<token>#/curso/play/... — os segmentos vão em base64.
AVP_EMPRESAS_URL=http://localhost:9000

# Provider de LLM usado na busca semântica por tema, geração de enquetes e
# materiais (slides/simulado/resumo). Primário + fallback automático (ver
# src/llm/llm.module.ts). "none" desliga o fallback.
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=anthropic

# Gemini — provider primário (mais barato). Sem nenhuma chave (Gemini nem
# Anthropic), o modo tema cai para busca textual (ILIKE) e a geração de
# enquete/materiais responde 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY_MS=5000
GEMINI_RETRY_MAX_DELAY_MS=60000
GEMINI_CONCURRENCY=3

# Anthropic (Claude) — fallback quando o Gemini falha/está sem cota. Também é
# o único provider que faz busca web de verdade (material complementar).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=45000
ANTHROPIC_MAX_RETRIES=4
ANTHROPIC_RETRY_BASE_DELAY_MS=5000
ANTHROPIC_RETRY_MAX_DELAY_MS=60000
ANTHROPIC_CONCURRENCY=3

# Unsplash — banco de imagens reais pros slides de desenvolvimento. Sem
# chave, cai direto para Wikimedia Commons e, por fim, Picsum (nunca falha,
# mas não é fotografia real).
UNSPLASH_ACCESS_KEY=

# poll360 (módulo de enquete do p360-monolith) — o hackaton só cria o conteúdo
# e abre a sessão; a votação ao vivo (PIN/QR, resultados) roda no poll360.
# Base da API do monolith (o prefixo /api/v1/poll360 é adicionado pelo serviço).
# Dentro do Docker use host.docker.internal em vez de localhost.
MONOLITH_BACKEND_URL=http://localhost:3001
# Opcional: sobrescreve a base acima só para o poll360.
POLL360_API_URL=
# URL pública do survey-frontend, usada para montar o link/QR de entrada do
# aluno (ex.: https://poll.paciente360.com.br).
POLL360_PUBLIC_URL=http://localhost:9500
